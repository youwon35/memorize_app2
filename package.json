{
  "name": "memorize_app2",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "powershell -ExecutionPolicy Bypass -File .\\scripts\\start-dev-build.ps1",
    "start:lan": "powershell -ExecutionPolicy Bypass -File .\\scripts\\start-dev-build.ps1",
    "start:tunnel": "powershell -ExecutionPolicy Bypass -File .\\scripts\\start-dev-build.ps1 -HostMode tunnel",
    "start:go": "expo start",
    "android": "expo start --dev-client --android",
    "ios": "expo start --dev-client --ios",
    "web": "expo start --web",
    "build:dev": "npx eas-cli build --platform android --profile development",
    "build:preview": "npx eas-cli build --platform android --profile preview"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.102.0",
    "expo": "^54.0.0",
    "expo-auth-session": "~7.0.10",
    "expo-crypto": "~15.0.8",
    "expo-dev-client": "~6.0.20",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.21",
    "expo-linear-gradient": "~15.0.8",
    "expo-secure-store": "~15.0.8",
    "expo-web-browser": "~15.0.10",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-url-polyfill": "^3.0.0"
  },
  "devDependencies": {
    "babel-preset-expo": "~54.0.10"
  }
}
