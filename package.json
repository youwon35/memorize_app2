{
  "name": "memorize_app2",
  "version": "1.0.10",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "powershell -ExecutionPolicy Bypass -File .\\scripts\\start-dev-build.ps1",
    "start:lan": "powershell -ExecutionPolicy Bypass -File .\\scripts\\start-dev-build.ps1",
    "start:tunnel": "powershell -ExecutionPolicy Bypass -File .\\scripts\\start-dev-build.ps1 -HostMode tunnel",
    "start:go": "expo start --go",
    "android": "expo start --dev-client --android",
    "ios": "expo start --dev-client --ios",
    "web": "expo start --web",
    "build:dev": "npx eas-cli build --platform android --profile development",
    "build:preview": "npx eas-cli build --platform android --profile preview",
    "build:production": "npx eas-cli build --platform android --profile production",
    "submit:production": "npx eas-cli submit --platform android --profile production",
    "test": "node --test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.102.0",
    "expo": "~54.0.37",
    "expo-auth-session": "~7.0.11",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-linear-gradient": "~15.0.8",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-web-browser": "~15.0.11",
    "jszip": "^3.10.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.10",
    "typescript": "~5.9.2"
  }
}
