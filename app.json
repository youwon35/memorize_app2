{
  "expo": {
    "name": "MEMORIA",
    "slug": "memoria",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "memoria",
    "userInterfaceStyle": "light",
    "icon": "./app-icon.png",
    "splash": {
      "image": "./assets/memoria-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#050814"
    },
    "plugins": [
      [
        "expo-dev-client",
        {
          "launchMode": "launcher"
        }
      ],
      [
        "expo-web-browser",
        {
          "experimentalLauncherActivity": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MEMORIA가 노트 사진에서 단어 쌍을 읽을 수 있도록 사진 접근 권한이 필요합니다.",
          "cameraPermission": "MEMORIA가 노트 사진에서 단어 쌍을 읽을 수 있도록 카메라 접근 권한이 필요합니다.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store"
    ],
    "android": {
      "package": "com.memoria.app",
      "adaptiveIcon": {
        "foregroundImage": "./app-icon.png",
        "backgroundColor": "#050814"
      }
    },
    "ios": {
      "bundleIdentifier": "com.memoria.app"
    },
    "extra": {
      "eas": {
        "projectId": "6caf9ed8-f402-4743-8222-5e05fcedb0f2"
      }
    },
    "owner": "zinnn"
  }
}
