{
  "expo": {
    "name": "MEMORIA",
    "slug": "memoria",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "memoria",
    "userInterfaceStyle": "light",
    "icon": "./app-icon.png",
    "splash": {
      "image": "./assets/splash_full_preview.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F5FF"
    },
    "plugins": [
      [
        "expo-dev-client",
        {
          "launchMode": "launcher"
        }
      ],
      [
        "expo-web-browser",
        {
          "experimentalLauncherActivity": false
        }
      ],
      "expo-secure-store"
    ],
    "android": {
      "package": "com.youwon35.memoria",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F5FF"
      }
    },
    "ios": {
      "bundleIdentifier": "com.youwon35.memoria"
    },
    "extra": {
      "eas": {
        "projectId": "6caf9ed8-f402-4743-8222-5e05fcedb0f2"
      }
    },
    "owner": "zinnn"
  }
}
