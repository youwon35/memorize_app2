{
  "expo": {
    "name": "MEMORIA",
    "slug": "memoria",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "memoria",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/memoria-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#050814"
    },
    "plugins": [
      [
        "expo-web-browser",
        {
          "experimentalLauncherActivity": false
        }
      ],
      "expo-secure-store"
    ],
    "android": {
      "package": "com.memoria.app",
      "adaptiveIcon": {
        "backgroundColor": "#050814"
      }
    },
    "ios": {
      "bundleIdentifier": "com.memoria.app"
    }
  }
}
